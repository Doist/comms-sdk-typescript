{
    "name": "@doist/comms-sdk",
    "version": "2.0.2",
    "description": "A TypeScript wrapper for the Comms REST API.",
    "author": "Doist developers",
    "homepage": "https://doist.github.io/comms-sdk-typescript/",
    "repository": "https://github.com/Doist/comms-sdk-typescript",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24",
        "npm": ">=11"
    },
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "default": "./dist/esm/index.js"
        }
    },
    "sideEffects": false,
    "scripts": {
        "clean": "rimraf dist",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "build:esm": "npx tsc -p tsconfig.esm.json",
        "build:fix-esm": "node scripts/fix-esm-imports.cjs",
        "build:fix-dts": "node scripts/fix-dts-imports.cjs",
        "build": "npm-run-all clean build:esm build:fix-esm build:fix-dts",
        "type-check": "npx tsc --noEmit",
        "check": "oxlint src && oxfmt --check",
        "check:fix": "oxlint src --fix && oxfmt",
        "attw": "attw --pack --ignore-rules cjs-resolves-to-esm",
        "audit": "npm audit --audit-level=moderate",
        "integrity-checks": "npm-run-all clean check test build attw",
        "prepublishOnly": "npm run integrity-checks",
        "prepare": "npm run build"
    },
    "dependencies": {
        "@doist/sdk-kmp": "0.2.3",
        "camelcase": "9.0.0",
        "ts-custom-error": "3.3.1",
        "undici": "7.29.0",
        "uuid": "11.1.1",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.4",
        "@semantic-release/changelog": "6.0.3",
        "@semantic-release/git": "10.0.1",
        "conventional-changelog-conventionalcommits": "9.3.1",
        "husky": "9.1.7",
        "lint-staged": "17.0.8",
        "msw": "2.14.6",
        "npm-run-all2": "9.0.2",
        "obsidian": "1.13.1",
        "oxfmt": "0.56.0",
        "oxlint": "1.71.0",
        "rimraf": "6.1.3",
        "semantic-release": "25.0.5",
        "ts-node": "10.9.2",
        "typescript": "5.9.3",
        "vitest": "4.1.9"
    },
    "husky": {
        "hooks": {
            "pre-commit": "npx lint-staged && npm run build"
        }
    },
    "lint-staged": {
        "*.{ts,tsx}": "oxlint --fix",
        "*.{ts,tsx,json,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
    },
    "files": [
        "dist/esm/**/*",
        "dist/types/**/*",
        "!dist/**/*.test.js",
        "!dist/**/*.test.d.ts"
    ]
}
