{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "github>doist/renovate-config:integrations-base",
        "github>doist/renovate-config:integrations-automerge"
    ],
    "packageRules": [
        {
            "matchPackageNames": ["undici"],
            "allowedVersions": "<8.0.0",
            "description": "Hold undici on 7.x until the SDK is ready to raise its runtime Node floor to undici 8's >=22.19.0"
        },
        {
            "matchPackageNames": ["oxlint", "oxfmt"],
            "groupName": "ox toolchain",
            "description": "Group oxlint and oxfmt updates into a single PR"
        }
    ]
}
